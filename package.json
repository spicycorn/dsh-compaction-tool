{
  "name": "dsh-compaction-tool",
  "version": "0.4.0",
  "description": "DeepSeek Harness (DSH) plugin that offloads context compaction to a selectable, fast secondary model: a compress_context tool + /compact command that summarize older history into a durable checkpoint, plus a Settings panel (Compaction section) for all compaction settings — independent of a slow main model. 通过可选择的轻量副模型做上下文压缩的 DSH 插件（compress_context 工具 + /compact 命令 + 设置面板）。",
  "type": "module",
  "main": "lib/index.mjs",
  "module": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.mjs",
    "lib/index.d.ts",
    "lib/client.js",
    "src/compaction-tool.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "INSTALL.zh.md",
    "SYSTEM_PROMPT.md",
    "SYSTEM_PROMPT.zh.md",
    "build.mjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-token-meter": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-runtime": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-token-meter": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "compaction",
    "context-compression",
    "summarization",
    "secondary-model",
    "model-selection"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
